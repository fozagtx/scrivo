    "@types/node": "20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai": "^7.0.108",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "convex": "^1.7.1",
    "dayjs": "^1.11.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "formik": "^2.4.5",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "modern-async": "^2.0.0",
    "next": "^16.3.5",
    "postcss": "8.4.33",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
