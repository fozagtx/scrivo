{
  "name": "scrivo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all dev:init --parallel dev:backend dev:frontend",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "dev:backend": "convex dev",
    "dev:frontend": "next dev",
    "dev:init": "convex dev --until-success",
    "deploy": "convex deploy --cmd 'npm run build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL && node scripts/upload-static.mjs --prod --dist out"
  },
  "dependencies": {
